# Copier ce fichier vers .env.prod.local et remplir toutes les valeurs.
# .env.prod.local ne doit JAMAIS être commité (voir .gitignore).

# ── Ports publiés sur l'hôte ────────────────────────────────────────────────
API_PORT=3003
FRONTEND_PORT=3000

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_with_a_long_random_secret
POSTGRES_DB=annuel

# ── Backend ──────────────────────────────────────────────────────────────────
API_KEY=change_me_with_a_long_random_secret
JWT_SECRET=change_me_with_a_long_random_secret
JWT_REFRESH_SECRET=change_me_with_a_different_long_random_secret
PEPPER_SECRET=change_me_with_a_long_random_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=change_me

ADMIN_EMAIL=admin@example.com

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

CORS_ORIGIN=https://ton-domaine.fr

# ── Frontend → backend (côté serveur uniquement, jamais envoyé au navigateur) ─
# Le backend n'est pas exposé publiquement : le frontend le relaie en interne,
# via le réseau Docker, dans server/routes/backend/[...path].ts.
# Le préfixe NUXT_ est obligatoire pour que Nuxt relise cette valeur au
# démarrage du conteneur (sinon il garde celle figée au build).
NUXT_BACKEND_URL=http://backend:3003

# ── Frontend (variables publiques, exposées au navigateur) ────────────────────
# Chemins relatifs : le navigateur ne parle qu'au frontend, qui relaie vers le
# backend en interne. Pas besoin de sous-domaine ni de DNS public pour l'API.
NUXT_PUBLIC_API_BASE=/backend/api
# Doit être définie explicitement (même valeur) : Nuxt ne relit une clé
# publique au démarrage du conteneur que si son nom d'env var matche
# exactement, "apiUrl" retombe sinon sur son fallback figé au build.
NUXT_PUBLIC_API_URL=/backend/api
NUXT_PUBLIC_API_KEY=change_me_with_a_long_random_secret
NUXT_PUBLIC_BACKEND_URL=/backend
NUXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.ton-domaine.fr/script.js

# ── Umami (analytics auto-hébergé) ────────────────────────────────────────────
UMAMI_PORT=3005
UMAMI_DB_NAME=umami
UMAMI_DB_USER=umami
UMAMI_DB_PASSWORD=change_me_with_a_long_random_secret
UMAMI_APP_SECRET=change_me_with_a_long_random_secret
UMAMI_HASH_SALT=change_me_with_a_second_long_random_secret
